# Telegram
APP_ENV=development
BOT_TOKEN=

# Database / cache
POSTGRES_USER=baza
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=baza
DATABASE_URL=postgresql+asyncpg://baza:CHANGE_ME_STRONG_PASSWORD@localhost:5432/baza
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=

# Support (без @)
SUPPORT_USERNAME=
SUPPORT_RESPONSE_TIME=обычно в течение нескольких часов

# Admin: telegram id через запятую
ADMIN_TELEGRAM_IDS=

# Public URL бота/API — из него собирается ссылка для Happ
# Пример: https://vpn.example.com
SUBSCRIPTION_BASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1

# Официальная страница Happ
HAPP_DOWNLOAD_URL=https://www.happ.su/main

# Product
APP_NAME=Baza VPN
TRIAL_DAYS=7
DEVICE_LIMIT=3
SUBSCRIPTION_PRICE_RUB=299
SUBSCRIPTION_DAYS=30
ADMIN_MAX_EXTEND_DAYS=366
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
